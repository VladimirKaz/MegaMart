---
import SectionHeader from "../ui/SectionHeader.astro";
import ProductCard from "../ui/ProductCard.astro";
import { getCollection } from "astro:content";

const allProducts = await getCollection("products");

const products = allProducts.sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

const tabs = [
  { id: "mobiles", label: "Mobiles", active: true },
  { id: "tablets", label: "Tablets", active: false },
  { id: "laptops", label: "Laptops", active: false },
  { id: "watches", label: "Smartwatches", active: false },
];
---

<section class="best-deal">
  <div class="container">
    <SectionHeader
      title="Grab the best deal on "
      highlight="Smartphones"
      linkText="View All"
      linkHref="/catalog/smartphones"
    />

    <!-- Сетка карточек -->
    <div class="best-deal__grid">
      {allProducts.map((product) => <ProductCard product={product} />)}
    </div>

  </div>

  <style>
    .best-deal {
      padding: 0;
      margin-top: 120px;
    }

    /* --- ТАБЫ --- */
    .best-deal__tabs-container {
      margin-bottom: 24px;
      border-bottom: 1px solid var(--color-border);
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none; /* Firefox */
    }
    .best-deal__tabs-container::-webkit-scrollbar {
      display: none; /* Chrome/Safari */
    }

    .best-deal__tabs {
      display: flex;
      gap: 32px;
      padding: 0;
      margin: 0;
      list-style: none;
      min-width: max-content;
    }

    .best-deal__tab-btn {
      position: relative;
      padding: 12px 0;
      font-size: 16px;
      font-weight: 500;
      color: var(--color-text-secondary);
      background: none;
      border: none;
      cursor: pointer;
      transition: color 0.2s;
    }
    .best-deal__tab-btn:hover {
      color: var(--color-text);
    }

    /* Активный таб */
    .best-deal__tab-btn.is-active {
      color: var(--color-primary);
    }
    .best-deal__tab-btn.is-active::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px; /* Перекрываем нижнюю границу контейнера */
      height: 3px;
      background: var(--color-primary);
      border-radius: 3px 3px 0 0;
    }

    /* --- СЕТКА КАРТОЧЕК --- */
    .best-deal__grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 16px;
    }

    /* --- АДАПТИВ --- */
    @media (max-width: 1200px) {
      /* На экранах чуть меньше — 4 колонки */
      .best-deal__grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    @media (max-width: 1024px) {
      /* На планшетах — 3 колонки */
      .best-deal__grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 768px) {
      /* На мобилках — 2 колонки */
      .best-deal__grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }
    }
  </style>
</section>