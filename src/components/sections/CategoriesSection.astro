---
import SectionHeader from "../ui/SectionHeader.astro";
import CategoryCard from "../ui/CategoryCard.astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/categories/*.png",
  { eager: true },
);

const getImage = (name: string) => {
  const path = `../../assets/images/categories/${name}.png`;
  return images[path]?.default;
};

const categories = [
  {
    title: "Mobile",
    image: getImage("mobile"),
    href: "/catalog/mobile",
  },
  {
    title: "Cosmetics",
    image: getImage("cosmetics"),
    href: "/catalog/cosmetics",
  },
  {
    title: "Electronics",
    image: getImage("electronics"),
    href: "/catalog/electronics",
  },
  {
    title: "Furniture",
    image: getImage("furniture"),
    href: "/catalog/furniture",
  },
  {
    title: "Watches",
    image: getImage("watches"),
    href: "/catalog/watches",
  },
  {
    title: "Decor",
    image: getImage("decor"),
    href: "/catalog/decor",
  },
  {
    title: "Accessories",
    image: getImage("accessories"),
    href: "/catalog/accessories",
  },
];

