---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  brand: string; // "IPHONE"
  title: string; // "UP to 80% OFF"
  bgColor: string; // Цвет фона карточки
  labelBg: string; // Цвет плашки бренда
  labelColor: string; // Цвет текста на плашке
  textColor: string; // Цвет основного текста
  image: ImageMetadata; // Картинка телефона
  href?: string;
}

const {
  brand,
  title,
  bgColor,
  labelBg,
  labelColor,
  textColor,
  image,
  href = "#",
} = Astro.props;
---

<a
  href={href}
  class="brand-card"
  style={`--bg-color: ${bgColor}; --text-color: ${textColor};`}
>
  <div class="brand-card__content">
    <!-- Плашка бренда -->
    <div
      class="brand-card__label"
      style={`background: ${labelBg}; color: ${labelColor};`}
    >
      {brand}
    </div>

    <!-- Текст -->
    <h3 class="brand-card__title">{title}</h3>
  </div>

  <!-- Картинка (вылезает за края) -->
  <div class="brand-card__image-wrapper">
    <Image src={image} alt={brand} class="brand-card__image" loading="lazy" />
  </div>
</a>

<style>
  .brand-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    height: 207px;
    background: var(--bg-color);
    border-radius: var(--radius-md);
    padding: 30px;
    overflow: hidden;
    text-decoration: none;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .brand-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  /* Контент слева */
  .brand-card__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    width: 50%;
  }

  .brand-card__label {
    padding: 8px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .brand-card__title {
    font-size: 24px;
    font-weight: 600;
    color: var(--text-color);
    line-height: 1.25;
    margin: 0;
  }

  /* Картинка справа */
  .brand-card__image-wrapper {
    position: absolute;
    bottom: 0;
    right: 10px; /* Немного прижимаем вправо */
    width: 60%; /* Картинка занимает правую часть */
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    z-index: 1;
  }

  .brand-card__image {
    /* Позволяем картинке вылезать за пределы контейнера */
    height: 115%;
    width: auto;
    max-width: none;
    object-fit: contain;
    object-position: bottom right;
    transform: translateY(
      10%
    ); /* Еще немного опускаем, чтобы она "утопала" в карточке */
  }

  @media (max-width: 768px) {
    .brand-card {
      height: 180px;
      padding: 20px;
    }
    .brand-card__title {
      font-size: 18px;
    }
    .brand-card__label {
      padding: 6px 12px;
      font-size: 12px;
    }
    .brand-card__image {
      height: 105%; /* На мобилке уменьшаем выпирание */
    }
  }
</style>
