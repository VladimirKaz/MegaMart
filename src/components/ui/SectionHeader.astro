---
interface Props {
  title: string;
  highlight?: string;
  linkText?: string;
  linkHref?: string;
}

const { title, highlight, linkText, linkHref = "#" } = Astro.props;
---

<div class="section-header">
  <h2 class="section-header__title">
    {title}
    {highlight && <span class="section-header__highlight">{highlight}</span>}
  </h2>

  {
    linkText && (
      <a href={linkHref} class="section-header__link">
        {linkText}
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </a>
    )
  }
</div>

<style>
  .section-header {
    position: relative;
    padding-bottom: 16px;
    margin-bottom: 24px;
    
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    
    border-bottom: 1px solid var(--color-border);
  }
  .section-header::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    max-width: 281px;
    height: 3px;
    background: var(--color-primary);
    border-radius: 3px;
  }
  .section-header__title {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.25;
  }
  .section-header__highlight {
    color: var(--color-primary);
  }
  .section-header__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text);
    transition: color 0.2s;
    white-space: nowrap;
  }
  .section-header__link svg {
    color: var(--color-primary);
  }
  .section-header__link:hover {
    color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .section-header__title {
      font-size: 20px;
    }
    .section-header__link {
      font-size: 14px;
    }
  }
</style>
