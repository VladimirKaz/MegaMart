---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  product: {
    id: string;
    data: {
      name: string;
      price: number;
      oldPrice?: number;
      save?: number;
      discountPercent?: number;
      image: ImageMetadata;
    };
  };
}

const { product } = Astro.props;

const { name, price, oldPrice, save, discountPercent, image } = product.data;

const formatPrice = (n: number) => "₹" + n.toLocaleString("en-IN");
---

<article class="product-card">
  <a href={`/product/${product.id}`} class="product-card__link">
    <!-- Бейдж скидки + проверка есть ли скидка -->
    {
      discountPercent && (
        <span class="product-card__badge">{discountPercent}% OFF</span>
      )
    }

    <!-- Фото -->
    <div class="product-card__image">
      <Image
        src={image}
        alt={name}
        width={120}
        height={180}
        loading="eager"
        format="webp"
      />
    </div>

    <!-- Информация -->
    <div class="product-card__body">
      <h3 class="product-card__name">{name}</h3>
      <hr class="product-card__divider" />

      <div class="product-card__prices">
        <span class="product-card__price">{formatPrice(price)}</span>
        {
          oldPrice && (
            <span class="product-card__old-price">{formatPrice(oldPrice)}</span>
          )
        }
      </div>

      {save && <p class="product-card__save">Save - {formatPrice(save)}</p>}
    </div>
  </a>

  <!-- ДОБАВЛЯЕМ КНОПКУ -->
  <div class="product-card__actions">
    <button
      class="add-to-cart-btn"
      data-id={product.id}
      data-title={name}
      data-price={price}
      data-old-price={oldPrice || ""}
      data-image={image.src}
    >
      В корзину
    </button>
  </div>
</article>

<style>
  .product-card {
    position: relative;
    width: 100%;
    max-width: 227px;
    background: var(--color-bg-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }
  .product-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .product-card__link {
    display: block;
    color: inherit;
    padding: 20px 12px 12px;
  }

  /* Бейдж */
  .product-card__badge {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 51px;
    height: 53px;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
    border-radius: 0 var(--radius-md) 0 var(--radius-md);
    z-index: 1;
  }

  /* Фото */
  .product-card__image {
    height: 188px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }
  .product-card__image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* Контент */
  .product-card__body {
    background: var(--color-white);
    border-radius: 0 0 15px 15px;
    padding: 12px;
    margin: 0 -12px -12px;
  }

  .product-card__name {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: 10px;
    min-height: 36px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0 0 10px;
  }

  .product-card__prices {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 6px;
  }

  .product-card__price {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text);
  }

  .product-card__old-price {
    font-size: 16px;
    font-weight: 400;
    color: var(--color-text);
    text-decoration: line-through;
  }

  .product-card__save {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-success);
  }

  /* Кнопка добавления в корзину */
  /* Стили для кнопки */
  .product-card__actions {
    padding: 20px 12px 16px;
    background: var(--color-white);
  }

  .add-to-cart-btn {
    width: 100%;
    padding: 10px;
    background-color: var(--color-primary); /* Твой синий цвет */
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .add-to-cart-btn:hover {
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .product-card {
      max-width: none;
    }
    .product-card__image {
      height: 150px;
    }
    .product-card__name {
      font-size: 14px;
    }
    .product-card__prices,
    .product-card__price,
    .product-card__old-price,
    .product-card__save {
      font-size: 14px;
    }
  }
</style>

<script>
  import { addToCart } from "@/stores/cart";

  // Находим все кнопки добавления на странице
  const buttons = document.querySelectorAll(".add-to-cart-btn");

  buttons.forEach((button) => {
    button.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const dataset = target.dataset;

      // Собираем объект и отправляем в Nano Store
      addToCart({
        id: dataset.id!,
        title: dataset.title!,
        price: Number(dataset.price),
        oldPrice: dataset.oldPrice ? Number(dataset.oldPrice) : undefined,
        image: dataset.image!,
      });

      // Визуальный фидбек (чтобы пользователь понял, что клик сработал)
      const originalText = target.textContent;
      target.textContent = "Добавлено ✓";
      target.style.backgroundColor = "#10b981"; // Зеленый цвет

      setTimeout(() => {
        target.textContent = originalText;
        target.style.backgroundColor = "";
      }, 1500);
    });
  });
</script>
