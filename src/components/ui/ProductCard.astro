---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  product: {
    id: string;
    data: {
      name: string;
      price: number;
      oldPrice?: number;
      save?: number;
      discountPercent?: number;
      image: ImageMetadata;
    };
  };
}

const { product } = Astro.props;

const {
  name,
  price,
  oldPrice,
  save,
  discountPercent,
  image,
} = product.data;

const formatPrice = (n: number) => "₹" + n.toLocaleString("en-IN");
---

<article class="product-card">
  <a href={`/product/${product.id}`} class="product-card__link">
    <!-- Бейдж скидки + проверка есть ли скидка -->
    {
      discountPercent && (
        <span class="product-card__badge">{discountPercent}% OFF</span>
      )
    }

    <!-- Фото -->
    <div class="product-card__image">
      <Image
        src={image}
        alt={name}
        width={120}
        height={180}
        loading="eager"
        format="webp"
      />
    </div>

    <!-- Информация -->
    <div class="product-card__body">
      <h3 class="product-card__name">{name}</h3>
      <hr class="product-card__divider" />

      <div class="product-card__prices">
        <span class="product-card__price">{formatPrice(price)}</span>
        {
          oldPrice && (
            <span class="product-card__old-price">{formatPrice(oldPrice)}</span>
          )
        }
      </div>

      {save && <p class="product-card__save">Save - {formatPrice(save)}</p>}
    </div>
  </a>
</article>

<style>
  .product-card {
    position: relative;
    width: 100%;
    max-width: 227px;
    background: var(--color-bg-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }
  .product-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .product-card__link {
    display: block;
    color: inherit;
    padding: 20px 12px 12px;
  }

  /* Бейдж */
  .product-card__badge {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 51px;
    height: 53px;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
    border-radius: 0 var(--radius-md) 0 var(--radius-md);
    z-index: 1;
  }

  /* Фото */
  .product-card__image {
    height: 188px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }
  .product-card__image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* Контент */
  .product-card__body {
    background: var(--color-white);
    border-radius: 0 0 15px 15px;
    padding: 12px;
    margin: 0 -12px -12px;
  }

  .product-card__name {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: 10px;
    min-height: 36px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0 0 10px;
  }

  .product-card__prices {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 6px;
  }

  .product-card__price {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text);
  }

  .product-card__old-price {
    font-size: 16px;
    font-weight: 400;
    color: var(--color-text);
    text-decoration: line-through;
  }

  .product-card__save {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-success);
  }

  @media (max-width: 768px) {
    .product-card {
      max-width: none;
    }
    .product-card__image {
      height: 150px;
    }
    .product-card__name {
      font-size: 14px;
    }
    .product-card__prices,
    .product-card__price,
    .product-card__old-price,
    .product-card__save {
      font-size: 14px;
    }
  }
</style>
