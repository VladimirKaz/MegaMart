---
interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "/og-image.jpg" } = Astro.props;

// Безопасная проверка: если Astro.site не задан в конфиге, берем локальный адрес, чтобы сборка не падала
const siteURL = Astro.site ? Astro.site.origin : "http://localhost:4321";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- OpenGraph (Facebook, Telegram, LinkedIn, VK) -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
