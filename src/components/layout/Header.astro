---
import { Image } from "astro:assets";
import LogoHeader from "../ui/LogoHeader.astro";
import LogoLines from "@/assets/icons/logo-icon.svg";
// vue
import CartButton from "../vue/CartButton.vue";
import { isCartOpen } from "@/stores/cart";

const navRight = [
  { icon: "user", text: "Sign Up/Sign In", href: "/login" },
  { icon: "cart", text: "Cart", href: "/cart" },
];
---

<header class="header">
  <div class="container header__inner">
    <!-- Logo -->
    <a href="/" class="header__logo" aria-label="MegaMart — главная">
      <Image src={LogoLines} alt={"Mega mart magazine"} loading={"eager"} />

      <LogoHeader />
    </a>

    <!-- Search -->
    <form class="header__search" role="search" onsubmit="return false">
      <div class="header__search-inner">
        <svg
          class="header__search-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
        </svg>
        <input
          type="search"
          class="header__search-input"
          placeholder="Search essentials, groceries and more..."
          aria-label="Поиск по сайту"
        />
        <button type="submit" class="header__search-submit" aria-label="Найти">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
            <circle cx="3" cy="6" r="1" fill="currentColor" stroke="none"
            ></circle>
            <circle cx="3" cy="12" r="1" fill="currentColor" stroke="none"
            ></circle>
            <circle cx="3" cy="18" r="1" fill="currentColor" stroke="none"
            ></circle>
          </svg>
        </button>
      </div>
    </form>

    <!-- Right nav -->
    <ul class="header__nav">
      {
        navRight.map(({ icon, text, href }) => (
          <li class="header__nav-item">
            <a
              href={href}
              class={`header__nav-link ${icon === "cart" ? "open-cart" : ""}`}
              style={icon === "cart" ? "position: relative;" : ""}
            >
              {icon === "user" && (
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="8" r="4" />
                  <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
                </svg>
              )}
              {icon === "cart" && <CartButton client:load />}

              <span>{text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  import { isCartOpen } from "@/stores/cart";

  // Ищем нашу ссылку по классу и вешаем обработчик
  document.querySelector(".open-cart")?.addEventListener("click", (e) => {
    e.preventDefault();
    isCartOpen.set(true);
    console.log('set to open');
  });
</script>

<style>
  .header {
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    height: 90px;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 100%;
  }

  .header__logo {
    color: var(--color-primary);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  /* Search */
  .header__search {
    flex: 1;
    max-width: 507px;
  }

  .header__search-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 16px;
    background: var(--color-bg-3);
    border-radius: 10px;
    border: 1px solid transparent;
    transition:
      border-color 0.2s,
      background 0.2s;
  }

  .header__search-inner:focus-within {
    border-color: var(--color-primary);
    background: var(--color-white);
  }

  .header__search-icon {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .header__search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: 14px;
    color: var(--color-text);
    outline: none;
  }

  .header__search-input::placeholder {
    color: var(--color-text-secondary);
  }

  .header__search-submit {
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
  }

  .header__search-submit:hover {
    opacity: 0.7;
  }

  /* Right nav */
  .header__nav {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }

  .header__nav-item {
    display: flex;
    align-items: center;
  }

  .header__nav-item:first-child {
    padding-right: 20px;
    border-right: 1px solid var(--color-line);
  }

  .header__nav-link {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text-secondary);
    transition: color 0.2s;
  }

  .header__nav-link svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .header__nav-link:hover {
    color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .header__nav-link span {
      display: none;
    }
    .header__nav-item:first-child {
      padding-right: 12px;
    }
  }
  @media (max-width: 768px) {
    .header {
      height: 72px;
    }
    .header__inner {
      gap: 16px;
    }
    .header__logo svg {
      width: 110px;
      height: auto;
    }
    .header__search-inner {
      height: 40px;
      padding: 0 12px;
    }
    .header__search-input {
      font-size: 13px;
    }
  }
</style>
