---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/HeroSection.astro";
import BestDealSection from "@/components/sections/BestDealSection.astro";
import CategoriesSection from "@/components/sections/CategoriesSection.astro";
import BrandsSection from "@/components/sections/BrandsSection.astro";
import DailyEssentialsSection from "@/components/sections/DailyEssentialsSection.astro";
//logic
import CartDrawer from "@/components/vue/CartDrawer.vue";
import AuthModal from "@/components/vue/AuthModal.vue";
---

<BaseLayout title="Главная">
  <Hero />
  <BestDealSection />
  <CategoriesSection />
  <BrandsSection />
  <DailyEssentialsSection />

  <!-- ДОБАВЛЯЕМ КОРЗИНУ -->
  <CartDrawer client:only="vue" />
  <!-- Окно Авторизации -->
  <AuthModal client:only="vue" />
</BaseLayout>
